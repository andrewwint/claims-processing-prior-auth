{
  "B1_B2_agent_tools_list": {
    "body": {
      "id": 1,
      "jsonrpc": "2.0",
      "result": {
        "tools": [
          {
            "description": "Coverage and benefits for the member and service.",
            "inputSchema": {
              "properties": {
                "cpt_code": {
                  "description": "CPT code of the requested service",
                  "type": "string"
                },
                "member_id": {
                  "description": "Synthetic member ID",
                  "type": "string"
                }
              },
              "required": [
                "cpt_code",
                "member_id"
              ],
              "type": "object"
            },
            "name": "AgentTools___check_eligibility"
          },
          {
            "description": "Findings from the record for one criterion, each with its source.",
            "inputSchema": {
              "properties": {
                "case_id": {
                  "description": "Case ID",
                  "type": "string"
                },
                "criterion_id": {
                  "description": "Criterion ID from the compiled policy",
                  "type": "string"
                }
              },
              "required": [
                "case_id",
                "criterion_id"
              ],
              "type": "object"
            },
            "name": "AgentTools___extract_clinical_evidence"
          },
          {
            "description": "Verified criteria for the CPT code and payer.",
            "inputSchema": {
              "properties": {
                "cpt_code": {
                  "description": "CPT code",
                  "type": "string"
                },
                "payer_id": {
                  "description": "Synthetic payer ID",
                  "type": "string"
                }
              },
              "required": [
                "cpt_code",
                "payer_id"
              ],
              "type": "object"
            },
            "name": "AgentTools___fetch_policy_criteria"
          },
          {
            "description": "Send the case packet to a clinician queue with the gaps marked.",
            "inputSchema": {
              "properties": {
                "case_id": {
                  "description": "Case ID",
                  "type": "string"
                },
                "gaps": {
                  "description": "Criteria not met or checks failed",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "reason": {
                  "description": "Why the case needs a clinician",
                  "type": "string"
                }
              },
              "required": [
                "case_id",
                "reason"
              ],
              "type": "object"
            },
            "name": "AgentTools___route_to_reviewer"
          },
          {
            "description": "Approve a stored case packet. The approval service loads the packet, verifies the hash and re-runs every check before recording anything.",
            "inputSchema": {
              "properties": {
                "packet_hash": {
                  "description": "SHA-256 of the packet's canonical JSON",
                  "type": "string"
                },
                "packet_id": {
                  "description": "ID of the stored case packet",
                  "type": "string"
                }
              },
              "required": [
                "packet_hash",
                "packet_id"
              ],
              "type": "object"
            },
            "name": "ApprovalService___record_approval"
          }
        ]
      }
    },
    "http_status": 200
  },
  "B4_layer1_agent_token_on_reviewer": {
    "body": {
      "error": {
        "code": -32002,
        "message": "insufficient_scope - The request requires higher privileges than provided by the access token."
      },
      "id": 0,
      "jsonrpc": "2.0"
    },
    "http_status": 403
  },
